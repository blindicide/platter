<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Lets pkexec launch the helper in <prefix>/libexec/platter/ with a
  meaningful prompt. CMake installation writes this file (with the real install
  path substituted) to <prefix>/share/polkit-1/actions/. The exec.path
  annotation must match the installed helper path exactly.
-->
<policyconfig>
  <vendor>platter</vendor>
  <action id="org.platter.helper.run">
    <description>Give platter access to storage devices</description>
    <message>Authentication is required to let platter read and (after you confirm each operation) write storage devices</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@PLATTER_HELPER_INSTALLED_PATH@</annotate>
  </action>
</policyconfig>
