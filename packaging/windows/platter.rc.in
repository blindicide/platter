#include <windows.h>

IDI_PLATTER ICON "@PROJECT_SOURCE_DIR@/assets/platter.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Yakunin R.\0"
            VALUE "FileDescription", "platter storage operations suite\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "ProductName", "platter\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
            VALUE "LegalCopyright", "Yakunin R. (c) 2026. All rights reserved.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
